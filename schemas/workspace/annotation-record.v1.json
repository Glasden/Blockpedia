{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:workspace:annotation-record.v1",
  "title": "Blockpedia annotation record",
  "type": "object",
  "properties": {
    "schema_version": {"const": "annotation-record.v1"},
    "annotation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "subject_type": {"enum": ["block", "visual_variant"]},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "minecraft_version": {"const": "26.2"},
    "synonyms_zh": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "synonyms_en": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "summary_zh": {"type": "string", "minLength": 2, "maxLength": 500},
    "summary_en": {"type": "string", "minLength": 2, "maxLength": 500},
    "color_terms": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "shape_terms": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "material_impressions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "building_roles": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "style_tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "avoid_for": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 2, "maxLength": 500},
    "source": {
      "type": "object",
      "properties": {
        "type": {"enum": ["llm", "human_review"]},
        "model_id": {"type": ["string", "null"], "maxLength": 200},
        "prompt_version": {"type": ["string", "null"], "maxLength": 128},
        "wire_schema_id": {
          "type": ["string", "null"],
          "enum": [
            "annotation-batch-output.v1",
            null
          ]
        },
        "verified": {"type": "boolean"}
      },
      "required": ["type", "model_id", "prompt_version", "wire_schema_id", "verified"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "annotation_id",
    "subject_type",
    "subject_id",
    "minecraft_version",
    "synonyms_zh",
    "synonyms_en",
    "summary_zh",
    "summary_en",
    "color_terms",
    "shape_terms",
    "material_impressions",
    "building_roles",
    "style_tags",
    "avoid_for",
    "confidence",
    "reason",
    "source"
  ],
  "additionalProperties": false
}
