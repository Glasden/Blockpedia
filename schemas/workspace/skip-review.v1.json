{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:workspace:skip-review.v1",
  "title": "Blockpedia skip review",
  "type": "object",
  "properties": {
    "schema_version": {"const": "skip-review.v1"},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_type": {"enum": ["block", "state", "visual_variant"]},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 8192},
    "minecraft_version": {"const": "26.2"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 128},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reason_code": {
      "enum": [
        "REGISTRY_INCOMPLETE",
        "INVALID_STATE",
        "MISSING_TRANSLATION",
        "MISSING_TEXTURE",
        "EMPTY_RENDER",
        "BACKGROUND_ONLY_RENDER",
        "OBJECT_OFF_CANVAS",
        "OBJECT_TOO_SMALL",
        "FRAME_INCONSISTENT",
        "ANIMATED_FIXTURE_UNSUPPORTED",
        "FLUID_FIXTURE_UNSUPPORTED",
        "BLOCK_ENTITY_FIXTURE_UNSUPPORTED",
        "IO_ERROR",
        "SCHEMA_INVALID",
        "CHECKSUM_MISMATCH",
        "IDEMPOTENCY_CONFLICT",
        "EXPORTER_EXCEPTION"
      ]
    },
    "note": {"type": "string", "minLength": 2, "maxLength": 500},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "source_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "machine_failure_ref": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "required": [
    "schema_version",
    "review_id",
    "target_type",
    "target_id",
    "minecraft_version",
    "reviewer",
    "reviewed_at",
    "reason_code",
    "note",
    "evidence",
    "source_version",
    "machine_failure_ref"
  ],
  "additionalProperties": false
}
