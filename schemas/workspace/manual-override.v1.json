{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:workspace:manual-override.v1",
  "title": "Blockpedia semantic manual override",
  "type": "object",
  "properties": {
    "schema_version": {"const": "manual-override.v1"},
    "override_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "minecraft_version": {"const": "26.2"},
    "scope": {
      "type": "object",
      "properties": {
        "level": {"const": "variant"},
        "variant_id": {"type": "string", "pattern": "^minecraft:[a-z0-9_./-]+$"}
      },
      "required": ["level", "variant_id"],
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "properties": {
        "add_synonyms_zh": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "remove_synonyms_zh": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "add_synonyms_en": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "remove_synonyms_en": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "set_summary_zh": {"type": "string", "minLength": 2, "maxLength": 500},
        "set_summary_en": {"type": "string", "minLength": 2, "maxLength": 500},
        "add_color_terms": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "remove_color_terms": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "add_shape_terms": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "remove_shape_terms": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "add_material_impressions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "remove_material_impressions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "add_building_roles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "remove_building_roles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "add_style_tags": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "remove_style_tags": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "add_avoid_for": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "remove_avoid_for": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "set_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "reason": {"type": "string", "minLength": 2, "maxLength": 500},
    "author": {"type": "string", "minLength": 1, "maxLength": 128},
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "input_signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "required": [
    "schema_version",
    "override_id",
    "minecraft_version",
    "scope",
    "operations",
    "reason",
    "author",
    "approved_by",
    "created_at",
    "input_signature"
  ],
  "additionalProperties": false
}
