{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:workspace:qualification-review.v1",
  "title": "Blockpedia qualification review",
  "type": "object",
  "properties": {
    "schema_version": {"const": "qualification-review.v1"},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_type": {"const": "visual_variant"},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "minecraft_version": {"const": "26.2"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 128},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reason_code": {
      "enum": [
        "QUALIFICATION_CONFIRMED",
        "CONTEXT_REQUIRED",
        "NOT_A_BUILDING_CANDIDATE",
        "MANUAL_REINCLUSION",
        "OTHER"
      ]
    },
    "note": {"type": "string", "minLength": 2, "maxLength": 500},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "source_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "qualification": {"enum": ["eligible", "conditional", "excluded"]},
    "warnings": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "target_type",
    "target_id",
    "minecraft_version",
    "reviewer",
    "reviewed_at",
    "reason_code",
    "note",
    "evidence",
    "source_version",
    "qualification",
    "warnings"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"qualification": {"const": "conditional"}},
        "required": ["qualification"]
      },
      "then": {"properties": {"warnings": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {"qualification": {"enum": ["eligible", "excluded"]}},
        "required": ["qualification"]
      },
      "then": {"properties": {"warnings": {"maxItems": 0}}}
    },
    {
      "if": {
        "properties": {"qualification": {"const": "excluded"}},
        "required": ["qualification"]
      },
      "then": {
        "properties": {
          "note": {"minLength": 2},
          "evidence": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
