{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:provider:rerank-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "ranking",
    "needs_user_choice",
    "ambiguity_points",
    "suggested_followups"
  ],
  "properties": {
    "schema_id": {
      "const": "rerank-output.v1"
    },
    "ranking": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "fit", "reason"],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "fit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "needs_user_choice": {
      "type": "boolean"
    },
    "ambiguity_points": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "suggested_followups": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
