{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:exporter:render-metadata.v1",
  "title": "Blockpedia Render Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "render-metadata.v1" },
    "variant_id": { "$ref": "#/$defs/opaqueId" },
    "width": { "const": 512 },
    "height": { "const": 512 },
    "format": { "const": "PNG-RGBA" },
    "views": {
      "type": "array",
      "prefixItems": [
        { "const": "isometric" },
        { "const": "front" },
        { "const": "side" },
        { "const": "top" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "camera_policy_version": { "const": "camera.v1" },
    "camera_sha256": { "$ref": "#/$defs/hash" },
    "lighting_policy_version": { "const": "lighting.v1" },
    "lighting_sha256": { "$ref": "#/$defs/hash" },
    "background_sha256": { "$ref": "#/$defs/hash" },
    "backboard_sha256": { "$ref": "#/$defs/hash" },
    "support_fixture_sha256": { "$ref": "#/$defs/hash" },
    "fixture_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "fixture_version": { "const": "fixture.v1" },
    "render_environment_sha256": { "$ref": "#/$defs/hash" },
    "render_input_signature": { "$ref": "#/$defs/hash" },
    "resource_pack_sha256": { "$ref": "#/$defs/hash" },
    "tint_sensitive": { "type": "boolean" },
    "baseline_biome": { "type": ["string", "null"], "pattern": "^minecraft:[a-z0-9_./-]+$" },
    "mask": { "$ref": "#/$defs/mask" },
    "image_sha256": { "$ref": "#/$defs/hash" }
  },
  "required": [
    "schema_version",
    "variant_id",
    "width",
    "height",
    "format",
    "views",
    "camera_policy_version",
    "camera_sha256",
    "lighting_policy_version",
    "lighting_sha256",
    "background_sha256",
    "backboard_sha256",
    "support_fixture_sha256",
    "fixture_id",
    "fixture_version",
    "render_environment_sha256",
    "render_input_signature",
    "resource_pack_sha256",
    "tint_sensitive",
    "baseline_biome",
    "mask",
    "image_sha256"
  ],
  "allOf": [
    {
      "if": { "properties": { "tint_sensitive": { "const": true } } },
      "then": { "properties": { "baseline_biome": { "const": "minecraft:plains" } } }
    },
    {
      "if": { "properties": { "tint_sensitive": { "const": false } } },
      "then": { "properties": { "baseline_biome": { "const": null } } }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "present": { "const": true },
        "format": { "enum": ["PNG-GRAY8", "PNG-RGBA"] },
        "channel": { "enum": ["gray", "red", "green", "blue", "alpha"] },
        "threshold": { "type": "integer", "minimum": 0, "maximum": 255 },
        "sha256": { "$ref": "#/$defs/hash" }
      },
      "required": ["present", "format", "channel", "threshold", "sha256"]
    }
  }
}
