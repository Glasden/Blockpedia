{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:mcp:mcp-index-info-output.v2",
  "title": "Blockpedia MCP index info output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "minecraft_version",
    "release_id",
    "built_at",
    "counts",
    "official_disclaimer"
  ],
  "properties": {
    "minecraft_version": {
      "$ref": "#/$defs/minecraft_version"
    },
    "release_id": {
      "type": "string",
      "pattern": "^rel_[0-9a-f]{32}$"
    },
    "built_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks",
        "visual_variants",
        "audited_skips"
      ],
      "properties": {
        "blocks": {
          "type": "integer",
          "minimum": 0
        },
        "visual_variants": {
          "type": "integer",
          "minimum": 0
        },
        "audited_skips": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "official_disclaimer": {
      "const": "NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT."
    }
  },
  "$defs": {
    "minecraft_version": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}(?:\\.[0-9]{1,3})?$",
      "minLength": 3,
      "maxLength": 11
    }
  }
}
