{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:mcp:mcp-search-blocks-output.v1",
  "title": "Blockpedia MCP search blocks output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "minecraft_version",
    "resolved_release_id",
    "manifest_sha256",
    "warnings",
    "data"
  ],
  "properties": {
    "schema_version": {"const": "mcp-search-blocks-output.v1"},
    "request_id": {"$ref": "#/$defs/opaque_id"},
    "minecraft_version": {"$ref": "#/$defs/minecraft_version"},
    "resolved_release_id": {"$ref": "#/$defs/opaque_id"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "warnings": {"$ref": "#/$defs/warnings"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_id",
        "query",
        "hard_filters",
        "exclusion_summary",
        "candidates",
        "contact_sheet",
        "images",
        "reranked_by_llm"
      ],
      "properties": {
        "search_id": {"$ref": "#/$defs/opaque_id"},
        "query": {"type": "string", "minLength": 1, "maxLength": 2000},
        "hard_filters": {
          "type": "array",
          "items": {"$ref": "#/$defs/hard_filter"}
        },
        "exclusion_summary": {
          "type": "array",
          "items": {"$ref": "#/$defs/exclusion"}
        },
        "candidates": {
          "type": "array",
          "maxItems": 24,
          "items": {"$ref": "#/$defs/candidate"}
        },
        "contact_sheet": {"$ref": "#/$defs/contact_sheet"},
        "images": {
          "type": "array",
          "items": {"$ref": "#/$defs/image"}
        },
        "reranked_by_llm": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "minecraft_version": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}(?:\\.[0-9]{1,3})?$",
      "minLength": 3,
      "maxLength": 11
    },
    "block_id": {
      "type": "string",
      "pattern": "^minecraft:[a-z0-9_./-]+$"
    },
    "state_id": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^minecraft:[a-z0-9_./-]+(?:\\[[a-z0-9_]+=[a-z0-9_.-]+(?:,[a-z0-9_]+=[a-z0-9_.-]+)*\\])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "scalar": {
      "type": ["boolean", "number", "string"]
    },
    "hard_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "source", "reason"],
      "properties": {
        "field": {"type": "string", "minLength": 1, "maxLength": 200},
        "operator": {"enum": ["equals", "not_equals", "include", "exclude"]},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/scalar"},
            {"type": "array", "items": {"$ref": "#/$defs/scalar"}, "uniqueItems": true}
          ]
        },
        "source": {"enum": ["user_explicit", "system"]},
        "reason": {"type": "string", "minLength": 2, "maxLength": 500}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count"],
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 200},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "score_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "color", "use", "name_synonym", "style", "behavior"],
      "properties": {
        "shape": {"type": "number", "minimum": 0, "maximum": 1},
        "color": {"type": "number", "minimum": 0, "maximum": 1},
        "use": {"type": "number", "minimum": 0, "maximum": 1},
        "name_synonym": {"type": "number", "minimum": 0, "maximum": 1},
        "style": {"type": "number", "minimum": 0, "maximum": 1},
        "behavior": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "machine_fact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "record_id", "field"],
      "properties": {
        "record_type": {"enum": ["state", "visual_variant"]},
        "record_id": {"anyOf": [{"$ref": "#/$defs/opaque_id"}, {"$ref": "#/$defs/state_id"}]},
        "field": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "variant_id",
        "block_id",
        "display_name",
        "recommended_state_id",
        "candidate_qualification",
        "local_score",
        "final_score",
        "score_source",
        "score_breakdown",
        "reason",
        "warnings",
        "machine_fact_refs"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/opaque_id"},
        "variant_id": {"$ref": "#/$defs/opaque_id"},
        "block_id": {"$ref": "#/$defs/block_id"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "recommended_state_id": {"$ref": "#/$defs/state_id"},
        "candidate_qualification": {"enum": ["eligible", "conditional", "excluded"]},
        "local_score": {"type": "number", "minimum": 0, "maximum": 1},
        "final_score": {"type": "number", "minimum": 0, "maximum": 1},
        "score_source": {"enum": ["local", "llm_rerank"]},
        "score_breakdown": {"$ref": "#/$defs/score_breakdown"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "warnings": {"$ref": "#/$defs/warnings"},
        "machine_fact_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/machine_fact_ref"}
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "variant_id", "block_id", "row", "column"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/opaque_id"},
        "variant_id": {"$ref": "#/$defs/opaque_id"},
        "block_id": {"$ref": "#/$defs/block_id"},
        "row": {"type": "integer", "minimum": 0},
        "column": {"type": "integer", "minimum": 0}
      }
    },
    "contact_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id", "tile_mapping"],
      "properties": {
        "image_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "tile_mapping": {"type": "array", "items": {"$ref": "#/$defs/tile"}}
      }
    },
    "image_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "variant_id", "block_id"],
      "properties": {
        "candidate_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "variant_id": {"$ref": "#/$defs/opaque_id"},
        "block_id": {"$ref": "#/$defs/block_id"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id", "purpose", "mime_type", "width", "height", "sha256", "content_index", "mapping"],
      "properties": {
        "image_id": {"$ref": "#/$defs/opaque_id"},
        "purpose": {"enum": ["search_contact_sheet", "compare_contact_sheet"]},
        "mime_type": {"const": "image/png"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_index": {"type": "integer", "minimum": 0},
        "mapping": {"type": "array", "items": {"$ref": "#/$defs/image_mapping"}}
      }
    }
  }
}
