{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:mcp:mcp-block-details-output.v1",
  "title": "Blockpedia MCP block details output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "minecraft_version", "resolved_release_id", "manifest_sha256", "warnings", "data"],
  "properties": {
    "schema_version": {"const": "mcp-block-details-output.v1"},
    "request_id": {"$ref": "#/$defs/opaque_id"},
    "minecraft_version": {"$ref": "#/$defs/minecraft_version"},
    "resolved_release_id": {"$ref": "#/$defs/opaque_id"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "warnings": {"$ref": "#/$defs/warnings"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "official_names", "translation_key", "default_state_id", "property_definitions", "states", "block_facts", "variants", "images", "audit"],
      "properties": {
        "block_id": {"$ref": "#/$defs/block_id"},
        "official_names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zh_cn", "en_us"],
          "properties": {
            "zh_cn": {"type": ["string", "null"]},
            "en_us": {"type": ["string", "null"]}
          }
        },
        "translation_key": {"type": "string", "minLength": 1, "maxLength": 255},
        "default_state_id": {"$ref": "#/$defs/state_id"},
        "property_definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "allowed_values"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 64},
              "allowed_values": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true}
            }
          }
        },
        "states": {"type": "array", "items": {"$ref": "#/$defs/state"}},
        "block_facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["has_item", "has_block_entity", "tags", "default_state_behavior"],
          "properties": {
            "has_item": {"$ref": "#/$defs/tristate"},
            "has_block_entity": {"$ref": "#/$defs/tristate"},
            "tags": {"type": "array", "items": {"$ref": "#/$defs/block_id"}, "uniqueItems": true},
            "default_state_behavior": {"$ref": "#/$defs/behavior"}
          }
        },
        "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
        "images": {"type": "array", "items": {"$ref": "#/$defs/image"}},
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skip_records", "override_refs", "qualification_review_refs"],
          "properties": {
            "skip_records": {"type": "array", "items": {"$ref": "#/$defs/opaque_id"}},
            "override_refs": {"type": "array", "items": {"$ref": "#/$defs/opaque_id"}},
            "qualification_review_refs": {"type": "array", "items": {"$ref": "#/$defs/opaque_id"}}
          }
        }
      }
    }
  },
  "$defs": {
    "opaque_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"},
    "minecraft_version": {"type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}(?:\\.[0-9]{1,3})?$", "minLength": 3, "maxLength": 11},
    "block_id": {"type": "string", "pattern": "^minecraft:[a-z0-9_./-]+$"},
    "state_id": {"type": "string", "maxLength": 8192, "pattern": "^minecraft:[a-z0-9_./-]+(?:\\[[a-z0-9_]+=[a-z0-9_.-]+(?:,[a-z0-9_]+=[a-z0-9_.-]+)*\\])?$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "tristate": {"oneOf": [{"type": "boolean"}, {"const": "unknown"}]},
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transparent", "emissive", "emission_level", "passable", "waterloggable", "requires_support", "redstone_related", "support"],
      "properties": {
        "transparent": {"$ref": "#/$defs/tristate"},
        "emissive": {"$ref": "#/$defs/tristate"},
        "emission_level": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 15}, {"const": "unknown"}]},
        "passable": {"$ref": "#/$defs/tristate"},
        "waterloggable": {"$ref": "#/$defs/tristate"},
        "requires_support": {"$ref": "#/$defs/tristate"},
        "redstone_related": {"$ref": "#/$defs/tristate"},
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["above", "below", "east", "north", "south", "west", "none"],
          "properties": {
            "above": {"$ref": "#/$defs/tristate"},
            "below": {"$ref": "#/$defs/tristate"},
            "east": {"$ref": "#/$defs/tristate"},
            "north": {"$ref": "#/$defs/tristate"},
            "south": {"$ref": "#/$defs/tristate"},
            "west": {"$ref": "#/$defs/tristate"},
            "none": {"$ref": "#/$defs/tristate"}
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boxes", "signature"],
      "properties": {
        "boxes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["min_x", "min_y", "min_z", "max_x", "max_y", "max_z"], "properties": {"min_x": {"type": "number"}, "min_y": {"type": "number"}, "min_z": {"type": "number"}, "max_x": {"type": "number"}, "max_y": {"type": "number"}, "max_z": {"type": "number"}}}},
        "signature": {"$ref": "#/$defs/sha256"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "is_default", "properties", "shape", "collision", "behavior", "variant_ids", "mapping_status"],
      "properties": {
        "state_id": {"$ref": "#/$defs/state_id"},
        "is_default": {"type": "boolean"},
        "properties": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "value": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}}}},
        "shape": {"$ref": "#/$defs/shape"},
        "collision": {"$ref": "#/$defs/shape"},
        "behavior": {"$ref": "#/$defs/behavior"},
        "variant_ids": {"type": "array", "items": {"$ref": "#/$defs/block_id"}, "uniqueItems": true},
        "mapping_status": {"enum": ["mapped", "skipped"]}
      }
    },
    "annotation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["summary_zh", "summary_en", "confidence"],
      "properties": {
        "summary_zh": {"type": "string", "minLength": 2, "maxLength": 500},
        "summary_en": {"type": "string", "minLength": 2, "maxLength": 500},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "canonical_state_id", "represented_state_ids", "candidate_qualification", "warnings", "variant_facts", "annotation", "image_ids"],
      "properties": {
        "variant_id": {"$ref": "#/$defs/block_id"},
        "canonical_state_id": {"$ref": "#/$defs/state_id"},
        "represented_state_ids": {"type": "array", "items": {"$ref": "#/$defs/state_id"}, "uniqueItems": true},
        "candidate_qualification": {"enum": ["eligible", "conditional", "excluded"]},
        "warnings": {"$ref": "#/$defs/warnings"},
        "variant_facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["geometry_summary", "geometry_signature", "collision_signature", "geometry_classes", "machine_tags", "state_behaviors"],
          "properties": {
            "geometry_summary": {"$ref": "#/$defs/shape"},
            "geometry_signature": {"$ref": "#/$defs/sha256"},
            "collision_signature": {"$ref": "#/$defs/sha256"},
            "geometry_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "machine_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "state_behaviors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["state_id", "behavior"], "properties": {"state_id": {"$ref": "#/$defs/state_id"}, "behavior": {"$ref": "#/$defs/behavior"}}}}
          }
        },
        "annotation": {"$ref": "#/$defs/annotation"},
        "image_ids": {"type": "array", "items": {"$ref": "#/$defs/opaque_id"}, "uniqueItems": true}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id", "purpose", "mime_type", "width", "height", "sha256", "content_index", "mapping"],
      "properties": {
        "image_id": {"$ref": "#/$defs/opaque_id"},
        "purpose": {"const": "block_variant_views"},
        "mime_type": {"const": "image/png"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_index": {"type": "integer", "minimum": 0},
        "mapping": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "variant_id", "block_id"], "properties": {"candidate_id": {"type": ["string", "null"]}, "variant_id": {"$ref": "#/$defs/block_id"}, "block_id": {"$ref": "#/$defs/block_id"}}}}
      }
    }
  }
}
