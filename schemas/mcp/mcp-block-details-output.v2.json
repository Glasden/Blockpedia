{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:mcp:mcp-block-details-output.v2",
  "title": "Blockpedia MCP block details output",
  "description": "Either a detail=summary object or a detail=states page.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "block_id": {
      "$ref": "#/$defs/block_id"
    },
    "official_names": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh_cn",
        "en_us"
      ],
      "properties": {
        "zh_cn": {
          "type": [
            "string",
            "null"
          ]
        },
        "en_us": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "default_state_id": {
      "$ref": "#/$defs/state_id"
    },
    "properties": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/block_id"
      }
    },
    "has_item": {
      "$ref": "#/$defs/tristate"
    },
    "has_block_entity": {
      "$ref": "#/$defs/tristate"
    },
    "state_count": {
      "type": "integer",
      "minimum": 1
    },
    "representative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "candidate_qualification",
        "shape_class",
        "shape",
        "collision",
        "geometry_classes",
        "machine_tags",
        "behavior"
      ],
      "properties": {
        "state_id": {
          "$ref": "#/$defs/state_id"
        },
        "candidate_qualification": {
          "enum": [
            "eligible",
            "conditional",
            "excluded",
            null
          ]
        },
        "shape_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Registry-tag shape (stairs, slab, wall, fence, door, trapdoor, pane ...), else from the representative geometry: full_cube (solid full block), passable (no collision: plants, torches, rails), sheet (flat on the floor), small_fixture (at most half a block across: lanterns, flower pots, heads), partial_block (the rest: chests, cauldrons, anvils); other when there is no representative geometry."
        },
        "shape": {
          "$ref": "#/$defs/boxes"
        },
        "collision": {
          "$ref": "#/$defs/boxes"
        },
        "geometry_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "machine_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        },
        "colors": {
          "$ref": "#/$defs/colors"
        }
      }
    },
    "semantics": {
      "$ref": "#/$defs/semantics"
    },
    "family": {
      "$ref": "#/$defs/family"
    },
    "skip_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Audited reason the block has no visual variant."
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    },
    "images": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "release_id": {
      "type": "string",
      "pattern": "^rel_[0-9a-f]{32}$"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "states": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/state"
      }
    }
  },
  "oneOf": [
    {
      "description": "detail=summary. Geometry, behavior and the image describe representative.state_id only, not every state.",
      "required": [
        "block_id",
        "official_names",
        "default_state_id",
        "properties",
        "tags",
        "has_item",
        "has_block_entity",
        "state_count",
        "representative",
        "semantics",
        "warnings",
        "images"
      ],
      "properties": {
        "release_id": false,
        "total": false,
        "offset": false,
        "next_offset": false,
        "states": false
      }
    },
    {
      "description": "detail=states. States are ordered by the UTF-8 bytes of state_id; if release_id differs between pages, discard collected pages and restart at offset 0.",
      "required": [
        "block_id",
        "release_id",
        "total",
        "offset",
        "next_offset",
        "states"
      ],
      "properties": {
        "official_names": false,
        "default_state_id": false,
        "properties": false,
        "tags": false,
        "has_item": false,
        "has_block_entity": false,
        "state_count": false,
        "representative": false,
        "semantics": false,
        "skip_reason": false,
        "warnings": false,
        "images": false,
        "family": false
      }
    }
  ],
  "$defs": {
    "block_id": {
      "type": "string",
      "pattern": "^minecraft:[a-z0-9_./-]+$"
    },
    "state_id": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^minecraft:[a-z0-9_./-]+(?:\\[[a-z0-9_]+=[a-z0-9_.-]+(?:,[a-z0-9_]+=[a-z0-9_.-]+)*\\])?$"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "tristate": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runtime behavior facts. Unexported support facts are omitted: a missing requires_support or support side means unknown, never false.",
      "required": [
        "transparent",
        "emissive",
        "emission_level",
        "passable",
        "waterloggable",
        "redstone_related"
      ],
      "properties": {
        "transparent": {
          "$ref": "#/$defs/tristate"
        },
        "emissive": {
          "$ref": "#/$defs/tristate"
        },
        "emission_level": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            {
              "const": "unknown"
            }
          ]
        },
        "passable": {
          "$ref": "#/$defs/tristate"
        },
        "waterloggable": {
          "$ref": "#/$defs/tristate"
        },
        "requires_support": {
          "type": "boolean"
        },
        "redstone_related": {
          "$ref": "#/$defs/tristate"
        },
        "support": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "above": {
              "type": "boolean"
            },
            "below": {
              "type": "boolean"
            },
            "east": {
              "type": "boolean"
            },
            "north": {
              "type": "boolean"
            },
            "south": {
              "type": "boolean"
            },
            "west": {
              "type": "boolean"
            },
            "none": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_x",
        "min_y",
        "min_z",
        "max_x",
        "max_y",
        "max_z"
      ],
      "properties": {
        "min_x": {
          "type": "number"
        },
        "min_y": {
          "type": "number"
        },
        "min_z": {
          "type": "number"
        },
        "max_x": {
          "type": "number"
        },
        "max_y": {
          "type": "number"
        },
        "max_z": {
          "type": "number"
        }
      }
    },
    "boxes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/box"
      }
    },
    "semantics": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Published semantic projection of the representative visual variant; null when the block has no visual variant.",
      "properties": {
        "synonyms_zh": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "synonyms_en": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "summary_zh": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "summary_en": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "color_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "shape_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "material_impressions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "building_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "style_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "avoid_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lossless 256x256 WebP card of the representative state's four views (128px each).",
      "required": [
        "content_index",
        "mime_type",
        "width",
        "height",
        "state_id"
      ],
      "properties": {
        "content_index": {
          "type": "integer",
          "minimum": 1,
          "description": "Index of the ImageContent in the tool result content array."
        },
        "mime_type": {
          "const": "image/webp"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "state_id": {
          "$ref": "#/$defs/state_id"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "is_default",
        "properties",
        "shape",
        "collision",
        "behavior",
        "variant_ids",
        "mapping_status"
      ],
      "properties": {
        "state_id": {
          "$ref": "#/$defs/state_id"
        },
        "is_default": {
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          }
        },
        "shape": {
          "$ref": "#/$defs/boxes"
        },
        "collision": {
          "$ref": "#/$defs/boxes"
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        },
        "variant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/block_id"
          }
        },
        "mapping_status": {
          "enum": [
            "mapped",
            "skipped"
          ]
        }
      }
    },
    "face_colors": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "hex",
        "lightness",
        "lightness_std",
        "dominant"
      ],
      "properties": {
        "hex": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "lightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "CIELAB L* of the mean colour."
        },
        "lightness_std": {
          "type": "number",
          "minimum": 0,
          "description": "Standard deviation of per-pixel L*: near 0 smooth (concrete), about 4 stone, 10+ mottled (cobblestone)."
        },
        "dominant": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "description": "Up to three colour clusters, largest first; clusters under 10% of the face are left out.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hex",
              "share"
            ],
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "side"
      ],
      "description": "Texture colours of the top face and the side faces (north and east views), read from the preview with the renderer's fixed face shading divided back out. A face with too few visible pixels is null.",
      "properties": {
        "top": {
          "$ref": "#/$defs/face_colors"
        },
        "side": {
          "$ref": "#/$defs/face_colors"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_block",
        "forms"
      ],
      "description": "Shapes this block's material comes in, from the registry naming rule (oak_planks: oak_stairs, oak_slab ...). base_block is the material's full block (the block itself when it has no forms, as spruce_log), null when there is none (petrified_oak_slab); forms is empty when the full block has no shaped forms. material_blocks, when present, lists every full block of the same material in other finishes, base_block included (spruce_log, spruce_planks, spruce_wood, stripped_spruce_log, stripped_spruce_wood; tuff, polished_tuff, tuff_bricks, chiseled_tuff ...); a copper block's wax and oxidation stage are part of its material.",
      "properties": {
        "base_block": {
          "oneOf": [
            {
              "$ref": "#/$defs/block_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "forms": {
          "type": "object",
          "minProperties": 0,
          "additionalProperties": false,
          "properties": {
            "stairs": {
              "$ref": "#/$defs/block_id"
            },
            "slab": {
              "$ref": "#/$defs/block_id"
            },
            "wall": {
              "$ref": "#/$defs/block_id"
            },
            "fence": {
              "$ref": "#/$defs/block_id"
            },
            "fence_gate": {
              "$ref": "#/$defs/block_id"
            },
            "door": {
              "$ref": "#/$defs/block_id"
            },
            "trapdoor": {
              "$ref": "#/$defs/block_id"
            },
            "button": {
              "$ref": "#/$defs/block_id"
            },
            "pressure_plate": {
              "$ref": "#/$defs/block_id"
            },
            "sign": {
              "$ref": "#/$defs/block_id"
            },
            "hanging_sign": {
              "$ref": "#/$defs/block_id"
            },
            "pane": {
              "$ref": "#/$defs/block_id"
            },
            "bars": {
              "$ref": "#/$defs/block_id"
            },
            "carpet": {
              "$ref": "#/$defs/block_id"
            },
            "shelf": {
              "$ref": "#/$defs/block_id"
            }
          }
        },
        "material_blocks": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/block_id"
          }
        }
      }
    }
  }
}
