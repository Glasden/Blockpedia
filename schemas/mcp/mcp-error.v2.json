{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:mcp:mcp-error.v2",
  "title": "Blockpedia MCP error output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error_code",
    "message"
  ],
  "properties": {
    "error_code": {
      "enum": [
        "DATA_ROOT_INVALID",
        "CURRENT_POINTER_MISSING",
        "CURRENT_POINTER_INVALID",
        "VERSION_NOT_AVAILABLE",
        "RELEASE_NOT_FOUND",
        "RELEASE_NOT_BUILT",
        "INDEX_INFO_UNAVAILABLE",
        "INDEX_OPEN_FAILED",
        "BLOCK_NOT_FOUND",
        "BLOCK_HAS_NO_PREVIEW",
        "IMAGE_READ_FAILED",
        "IMAGE_MAPPING_INVALID",
        "READ_ONLY_VIOLATION",
        "MCP_INTERNAL_ERROR"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "available_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/minecraft_version"
      }
    },
    "invalid_block_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/block_id"
      }
    }
  },
  "$defs": {
    "minecraft_version": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}(?:\\.[0-9]{1,3})?$",
      "minLength": 3,
      "maxLength": 11
    },
    "block_id": {
      "type": "string",
      "pattern": "^minecraft:[a-z0-9_./-]+$"
    }
  }
}
