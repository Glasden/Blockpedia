{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:mcp:mcp-compare-blocks-output.v3",
  "title": "Blockpedia MCP compare blocks output",
  "description": "Every requested block with the same fields, in block_ids order. Each block describes its representative (first visual variant) as get_block_details does.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocks",
    "differing_fields",
    "images"
  ],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "differing_fields": {
      "type": "array",
      "uniqueItems": true,
      "description": "Fields whose values are not all equal across blocks.",
      "items": {
        "enum": [
          "candidate_qualification",
          "shape_class",
          "geometry_classes",
          "transparent",
          "emission_level",
          "redstone_related",
          "colors",
          "semantics",
          "family",
          "warnings"
        ]
      }
    },
    "images": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/image"
      }
    }
  },
  "$defs": {
    "block_id": {
      "type": "string",
      "pattern": "^minecraft:[a-z0-9_./-]+$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "tristate": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "display_name",
        "candidate_qualification",
        "shape_class",
        "geometry_classes",
        "transparent",
        "emission_level",
        "redstone_related",
        "colors",
        "semantics",
        "family",
        "warnings"
      ],
      "properties": {
        "block_id": {
          "$ref": "#/$defs/block_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id",
          "description": "Label of this block's card on the contact sheet; absent when the block has no visual variant."
        },
        "candidate_qualification": {
          "enum": [
            "eligible",
            "conditional",
            "excluded",
            null
          ]
        },
        "shape_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Registry-tag shape (stairs, slab, wall, fence, door, trapdoor, pane ...), else from the representative geometry: full_cube (solid full block), passable (no collision: plants, torches, rails), sheet (flat on the floor), small_fixture (at most half a block across: lanterns, flower pots, heads), partial_block (the rest: chests, cauldrons, anvils); other when there is no representative geometry."
        },
        "geometry_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "transparent": {
          "$ref": "#/$defs/tristate"
        },
        "emission_level": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            {
              "const": "unknown"
            }
          ]
        },
        "redstone_related": {
          "$ref": "#/$defs/tristate"
        },
        "colors": {
          "oneOf": [
            {
              "$ref": "#/$defs/colors"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantics": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Published semantic fields of the representative visual variant; null when the block has no visual variant. Only the English summary; get_block_details has both languages.",
          "properties": {
            "summary_en": {
              "type": "string",
              "minLength": 2,
              "maxLength": 500
            },
            "color_terms": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "material_impressions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "style_tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "building_roles": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "family": {
          "oneOf": [
            {
              "$ref": "#/$defs/family"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "face_colors": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "hex",
        "lightness",
        "lightness_std",
        "dominant"
      ],
      "properties": {
        "hex": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "lightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "CIELAB L* of the mean colour."
        },
        "lightness_std": {
          "type": "number",
          "minimum": 0,
          "description": "Standard deviation of per-pixel L*: near 0 smooth (concrete), about 4 stone, 10+ mottled (cobblestone)."
        },
        "dominant": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "description": "Up to three colour clusters, largest first; clusters under 10% of the face are left out.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hex",
              "share"
            ],
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Texture colours of the top face and the side faces (north and east views), read from the preview with the renderer's fixed face shading divided back out. A face with too few visible pixels is null. When top and side are within Oklab ΔE 2 (×100) and 2 L* spread of each other they are given once as top_and_side, with the top face's figures.",
      "properties": {
        "top": {
          "$ref": "#/$defs/face_colors"
        },
        "side": {
          "$ref": "#/$defs/face_colors"
        },
        "top_and_side": {
          "$ref": "#/$defs/face_colors"
        }
      },
      "oneOf": [
        {
          "required": [
            "top",
            "side"
          ],
          "not": {
            "required": [
              "top_and_side"
            ]
          }
        },
        {
          "required": [
            "top_and_side"
          ],
          "properties": {
            "top": false,
            "side": false
          }
        }
      ]
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_block",
        "forms"
      ],
      "description": "Shapes this block's material comes in, from the registry naming rule (oak_planks: oak_stairs, oak_slab ...). base_block is the material's full block (the block itself when it has no forms, as spruce_log), null when there is none (petrified_oak_slab); forms names the shapes, empty when the full block has none, and a form's block ID is form_id_pattern with {form} replaced (minecraft:oak_{form}: minecraft:oak_stairs). material_blocks, when present, lists every full block of the same material in other finishes, base_block included, as templates: a block ID is minecraft: plus the template with * replaced by material (material spruce: *_log, *_planks, *_wood, stripped_*_log, stripped_*_wood; material tuff: *, polished_*, *_bricks, chiseled_* ...); a copper block's wax and oxidation stage are part of its material and stay in the template (exposed_cut_*).",
      "properties": {
        "base_block": {
          "oneOf": [
            {
              "$ref": "#/$defs/block_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "forms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "stairs",
              "slab",
              "wall",
              "fence",
              "fence_gate",
              "door",
              "trapdoor",
              "button",
              "pressure_plate",
              "sign",
              "hanging_sign",
              "pane",
              "bars",
              "carpet",
              "shelf"
            ]
          }
        },
        "form_id_pattern": {
          "type": "string",
          "pattern": "^minecraft:[a-z0-9_./-]+_\\{form\\}$"
        },
        "material": {
          "type": "string",
          "pattern": "^[a-z0-9_./-]+$",
          "description": "Material word that replaces * in material_blocks."
        },
        "material_blocks": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_./-]*\\*[a-z0-9_./-]*$"
          }
        }
      },
      "if": {
        "properties": {
          "forms": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "form_id_pattern"
        ]
      },
      "else": {
        "properties": {
          "form_id_pattern": false
        }
      },
      "dependentRequired": {
        "material_blocks": [
          "material"
        ],
        "material": [
          "material_blocks"
        ]
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lossless WebP contact sheet of 256x256 cards, one per block with a candidate_id, labelled with it.",
      "required": [
        "content_index",
        "mime_type",
        "width",
        "height",
        "columns"
      ],
      "properties": {
        "content_index": {
          "type": "integer",
          "minimum": 1,
          "description": "Index of the ImageContent in the tool result content array."
        },
        "mime_type": {
          "const": "image/webp"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "description": "Tiles per row. Tiles are row-major in candidate order: T01 is the first tile, so candidate n is at row (n-1) div columns, column (n-1) mod columns; tile width is width / columns."
        }
      }
    }
  }
}
