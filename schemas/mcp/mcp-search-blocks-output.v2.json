{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockpedia:schema:mcp:mcp-search-blocks-output.v2",
  "title": "Blockpedia MCP search blocks output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates",
    "images"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "images": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/image"
      }
    }
  },
  "$defs": {
    "block_id": {
      "type": "string",
      "pattern": "^minecraft:[a-z0-9_./-]+$"
    },
    "state_id": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^minecraft:[a-z0-9_./-]+(?:\\[[a-z0-9_]+=[a-z0-9_.-]+(?:,[a-z0-9_]+=[a-z0-9_.-]+)*\\])?$"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "block_id",
        "display_name",
        "recommended_state_id",
        "candidate_qualification",
        "score",
        "score_breakdown",
        "reason",
        "warnings"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "block_id": {
          "$ref": "#/$defs/block_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "recommended_state_id": {
          "$ref": "#/$defs/state_id"
        },
        "candidate_qualification": {
          "enum": [
            "eligible",
            "conditional"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Local deterministic relevance after the derived-shape factor and recommendation-list deprioritization. With similar_to it is the palette similarity alone (keywords then only filter the pool)."
        },
        "score_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "color",
            "shape",
            "light"
          ],
          "properties": {
            "text": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "color": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "shape": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "light": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "description": "Dimensions the query asked for, each 0-1; a dimension the query did not ask for is 0 and not part of score. text: name/synonym/annotation word coverage; color: preview colour and stated colour; shape: registry-tag shape class; light: brightest emission level / 15. With similar_to: color is the palette similarity (1 identical, 0 at distance 0.25 or more), shape is 1 (same shape class required) and text is the keyword score when keywords were given."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        },
        "color_delta_e": {
          "type": "number",
          "minimum": 0,
          "description": "similar_to only: Oklab distance ×100 of the mean top and side face colours from the similar_to block."
        },
        "color_series": {
          "type": "object",
          "additionalProperties": false,
          "description": "Present when the query named no colour and other dye colours of this block's 16-colour series also matched; they are folded into this candidate. Substitute a colour into block_id_pattern for its block ID.",
          "required": [
            "block_id_pattern",
            "other_colors"
          ],
          "properties": {
            "block_id_pattern": {
              "type": "string",
              "pattern": "^minecraft:\\{color\\}_[a-z0-9_./-]+$"
            },
            "other_colors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "white",
                  "light_gray",
                  "gray",
                  "black",
                  "brown",
                  "red",
                  "orange",
                  "yellow",
                  "lime",
                  "green",
                  "cyan",
                  "light_blue",
                  "blue",
                  "purple",
                  "magenta",
                  "pink"
                ]
              }
            }
          }
        },
        "oxidation_series": {
          "type": "object",
          "additionalProperties": false,
          "description": "Present when other oxidation stages or waxed versions of this copper block also matched and were folded into this candidate: waxed versions always (they look the same), other stages when the query named no colour. Not folded for an exact name or ID match.",
          "required": [
            "other_block_ids"
          ],
          "properties": {
            "other_block_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/block_id"
              }
            }
          }
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "block_id",
        "row",
        "column"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "block_id": {
          "$ref": "#/$defs/block_id"
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lossless WebP contact sheet; each 256x256 card is labelled with its candidate_id.",
      "required": [
        "content_index",
        "mime_type",
        "width",
        "height",
        "tiles"
      ],
      "properties": {
        "content_index": {
          "type": "integer",
          "minimum": 1,
          "description": "Index of the ImageContent in the tool result content array."
        },
        "mime_type": {
          "const": "image/webp"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tile"
          }
        }
      }
    }
  }
}
